# Port the server listens on
PORT=3000
# PIN that turns a joining user into an admin (required; a random one is generated if missing)
ADMIN_PIN=1234
# Secret for the TV player page (/tv?key=...). Random if missing; printed at startup.
TV_KEY=change-me
# Optional: enables in-app YouTube search (YouTube Data API v3 key)
YOUTUBE_API_KEY=
# Max songs a guest can have waiting in the queue
GUEST_QUEUE_LIMIT=3
# SQLite database file
DB_PATH=data/dance-party.db
# Optional: fixed 4-letter room code (otherwise generated and persisted)
ROOM_CODE=
# Optional: base URL phones use, shown on the TV and in the QR code (default: auto-detected LAN IP; set it when using Docker)
PUBLIC_URL=
# Optional: hostname other devices use for the TV page (default: this computer's Bonjour name, e.g. mymac.local).
# YouTube blocks some videos when the page is opened by IP. If a device can't resolve .local names, try <ip-with-dashes>.nip.io
TV_HOST=
